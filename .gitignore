# Generated by Cargo
debug
/target

# Backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
**/mutants.out*/

# Model weights and KV snapshots — large, and machine-local.
*.gguf
*.safetensors
*.kv

# RustRover / JetBrains. The maintained template lives at
# https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#.idea/

.DS_Store

# cargo-fuzz build output and the corpus it grows. The seed corpus that
# steers it is checked in under tests/fixtures/gguf/corpus; what libFuzzer
# accumulates from there is machine-local and large.
/fuzz/target
/fuzz/corpus
/fuzz/artifacts
