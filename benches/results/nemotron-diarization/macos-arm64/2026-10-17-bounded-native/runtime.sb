(version 1)(allow default)(deny network*)(deny file-write*)
(allow file-write* (subpath "/Users/runner/work/_temp/bounded-native/results") (subpath "/Users/runner/work/_temp/bounded-native/home") (subpath "/Users/runner/work/_temp/bounded-native/tmp") (literal "/dev/null"))
