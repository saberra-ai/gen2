  "hypotheses": [
    {
      "rank": 1,
      "cause": "Fixed four-thread backend contention on small VM",
      "prediction": "Runnables spend substantial sampled time in GGML spin/barrier code; reducing threads in a later controlled variant would improve the same-input runtime."
    },
    {
      "rank": 2,
      "cause": "Portable CPU matrix kernels or Accelerate work dominates",
      "prediction": "Hot stacks are arithmetic/matrix kernels rather than worker barriers; a later kernel/backend ablation would change that cost."
    },
    {
      "rank": 3,
      "cause": "Shared VM scheduling delays dominate",
      "prediction": "Saved process CPU time is small relative to wall time, with host load/idle observations supporting scheduling delay. This one sample cannot prove an uncontended baseline."
    }
  ],
  "limits": [
    "One neural command only, after an actual model-free sampling control and offline policy controls.",
    "The original qualification, package, executable, criteria and failed attempts remain unchanged.",
    "Sampling and the shorter input confound direct comparison with the original60-second RTF; do not claim speedup.",
    "Sampler uses exact live PID/ps path, matching target dyld UUID and sample image UUID; macOS report paths are retained redacted.",
    "Strict dyld auditor still requires actual target and exact92 private-library hashes/paths; no launchers or profiler are whitelisted.",
    "All three downloaded model/card/audio inputs are hash-verified before offline native admission; no new corpus/quality selection.",
    "No Pnola GUI/microphone, signing/notarization, mixed inference, held-out quality, live performance or release claim."
  ]
