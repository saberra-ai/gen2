(version 1)
(allow default)
(deny network*)
(deny file-read* (subpath "/Users/runner/work/_temp/bounded-public/sdk") (subpath "/Users/runner/work/_temp/bounded-public/producer") (subpath "/Users/runner/work/_temp/bounded-public/native-reference") (subpath "/Users/runner/work/gen2/gen2") (subpath "/Users/runner/work/_temp/bounded-public/cargo-target") (subpath "/Users/runner/work/_temp/bounded-public/helper-source") (subpath "/opt/homebrew") (subpath "/Users/runner/.cargo") (subpath "/Users/runner/.rustup") (subpath "/Users/runner/work/_temp/bounded-public-delivery") (subpath "/Users/runner/work/_temp/bounded-public-delivery") (subpath "/Users/runner/work/_temp/bounded-public-assets") (subpath "/Users/runner/work/_temp/bounded-public/reference"))
(deny file-write* (subpath "/Users/runner/work/_temp/bounded-public/work") (subpath "/Users/runner/work/_temp/bounded-public/sdk") (subpath "/Users/runner/work/_temp/bounded-public/producer") (subpath "/Users/runner/work/_temp/bounded-public/native-reference") (subpath "/Users/runner/work/gen2/gen2") (subpath "/Users/runner/work/_temp/bounded-public/helper-source") (subpath "/Users/runner/work/_temp/bounded-public/reference"))
(deny file-read-data (subpath "/Users/runner/work/_temp/bounded-public/results"))
(deny file-read* (regex #".*\.(nemo|gguf|safetensors|onnx|npy|f32)$"))
