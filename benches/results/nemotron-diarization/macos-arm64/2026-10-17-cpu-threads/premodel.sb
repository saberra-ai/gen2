(version 1)(allow default)(deny network*)(deny file-write*)
(allow file-write* (subpath "/Users/runner/work/_temp/thread-contrast/results") (subpath "/Users/runner/work/_temp/thread-contrast/home") (subpath "/Users/runner/work/_temp/thread-contrast/tmp") (literal "/dev/null"))
(deny file-read-data (subpath "/Users/runner/work/_temp/thread-contrast/results"))
(deny file-read* (subpath "/Users/runner/work/gen2/gen2"))
(deny file-read* (subpath "/Users/runner/work/gen2/gen2/native-upstream"))
(deny file-read* (subpath "/Users/runner/work/_temp/thread-contrast/helper-native"))
(deny file-read* (subpath "/Users/runner/work/_temp/thread-contrast/ggml-headers"))
(deny file-read* (subpath "/Users/runner/work/_temp/thread-contrast/sdk"))
(deny file-read* (subpath "/Users/runner/work/_temp/thread-contrast/producer"))
(deny file-read* (subpath "/Users/runner/work/_temp/thread-contrast/native_reference"))
(deny file-read* (subpath "/opt/homebrew"))
(deny file-read* (subpath "/Users/runner/work/_temp/thread-delivery/producer.zip"))
(deny file-read* (subpath "/Users/runner/work/_temp/thread-delivery/producer.json"))
(deny file-read* (subpath "/Users/runner/work/_temp/thread-delivery/native-reference.zip"))
(deny file-read* (subpath "/Users/runner/work/_temp/thread-delivery/native-reference.json"))
(deny file-read* (subpath "/Users/runner/work/_temp/thread-contrast/work/assets"))
(deny file-read* (regex #".*\.(gguf|nemo|onnx|safetensors|npy|f32)$"))
