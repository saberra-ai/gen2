(version 1)
(allow default)
(deny network*)
(deny file-write*)
(allow file-write* (subpath "/Users/runner/work/_temp/pooled-profile/results") (subpath "/Users/runner/work/_temp/pooled-profile/home") (subpath "/Users/runner/work/_temp/pooled-profile/tmp") (literal "/dev/null"))
(deny file-read-data (subpath "/Users/runner/work/_temp/pooled-profile/results"))
(deny file-read* (subpath "/Users/runner/work/gen2/gen2"))
(deny file-read* (subpath "/Users/runner/work/_temp/pooled-profile/producer"))
(deny file-read* (subpath "/Users/runner/work/_temp/pooled-profile/native_reference"))
(deny file-read* (subpath "/opt/homebrew"))
(deny file-read* (subpath "/Users/runner/work/_temp/pooled-profile/control.c"))
(deny file-read* (subpath "/Users/runner/work/_temp/pooled-profile-delivery/producer.zip"))
(deny file-read* (subpath "/Users/runner/work/_temp/pooled-profile-delivery/producer.json"))
(deny file-read* (subpath "/Users/runner/work/_temp/pooled-profile-delivery/native-reference.zip"))
(deny file-read* (subpath "/Users/runner/work/_temp/pooled-profile-delivery/native-reference.json"))
(deny file-read* (subpath "/Users/runner/work/_temp/pooled-profile/work/assets"))
(deny file-read* (regex #".*\.(gguf|nemo|onnx|safetensors|npy|f32)$"))
