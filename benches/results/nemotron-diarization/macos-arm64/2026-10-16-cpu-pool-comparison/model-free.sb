(deny file-write* (subpath "/Users/runner/work/_temp/cpu-pools/work") (subpath "/Users/runner/work/gen2/gen2") (subpath "/Users/runner/work/_temp/pool-native-source") (subpath "/Users/runner/work/_temp/cpu-pools/sdk") (subpath "/Users/runner/work/_temp/cpu-pools/ggml-headers") (subpath "/Users/runner/work/_temp/cpu-pools/construction") (subpath "/Users/runner/work/_temp/cpu-pools/reference") (subpath "/Users/runner/work/_temp/pool-delivery/construction.zip") (subpath "/Users/runner/work/_temp/pool-delivery/construction.json") (subpath "/Users/runner/work/_temp/pool-delivery/reference.zip") (subpath "/Users/runner/work/_temp/pool-delivery/reference.json") (subpath "/opt/homebrew") (subpath "/Users/runner/.cargo") (subpath "/Users/runner/.rustup"))
