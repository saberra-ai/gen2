{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pnola",
  "version": "0.2.0",
  "identifier": "com.pnola.desktop",
  "build": {
    "beforeDevCommand": "npm run desktop:prepare && npm run dev:ui",
    "beforeBuildCommand": "npm run desktop:prepare && npm run build:ui",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Pnola",
        "width": 1240,
        "height": 920,
        "minWidth": 760,
        "minHeight": 650
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: blob:; media-src 'self' asset: http://asset.localhost blob:; font-src 'self'; object-src 'none'; base-uri 'none'",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../.desktop-assets/bark/": "bark/",
      "../.desktop-assets/runtime/": "runtime/",
      "../.desktop-assets/sample.wav": "sample.wav"
    },
    "macOS": {
      "minimumSystemVersion": "13.0",
      "entitlements": "Entitlements.plist",
      "frameworks": [
        "../.desktop-assets/runtime/libonnxruntime.dylib"
      ]
    }
  }
}
