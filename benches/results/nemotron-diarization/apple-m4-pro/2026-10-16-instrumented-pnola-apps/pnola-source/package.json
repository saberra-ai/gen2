{
  "name": "pnola",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "dev": "tauri dev",
    "dev:ui": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "tauri": "tauri",
    "desktop:prepare": "node scripts/prepare-desktop.mjs",
    "desktop:build": "node scripts/build-desktop.mjs",
    "desktop:check": "cargo check --manifest-path src-tauri/Cargo.toml",
    "desktop:test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "build": "npm run build:ui && npm run build:native",
    "build:ui": "vite build",
    "build:native": "node scripts/build-native.mjs",
    "check": "tsc --noEmit && node --check server.mjs && node --check long-audio.mjs && cargo fmt --manifest-path native/Cargo.toml --check && cargo fmt --manifest-path src-tauri/Cargo.toml --check",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-clipboard-manager": "^2.5.0",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "^6.2.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
