cmake_minimum_required(VERSION 3.21)
project(gen2_q8_mx4_control LANGUAGES C CXX)
if(NOT WIN32 OR NOT CMAKE_CXX_COMPILER_ID STREQUAL "Clang" OR NOT CMAKE_CXX_SIMULATE_ID STREQUAL "MSVC")
  message(FATAL_ERROR "actual Windows clang-cl control required")
endif()
foreach(input GGML_SOURCE CANDIDATE_SOURCE BENCHMARK_SOURCE)
  if(NOT EXISTS "${${input}}")
    message(FATAL_ERROR "missing frozen input ${input}")
  endif()
endforeach()
set(GGML_OPENMP OFF CACHE BOOL "" FORCE)
set(GGML_CPU OFF CACHE BOOL "" FORCE)
set(GGML_NATIVE OFF CACHE BOOL "" FORCE)
set(GGML_BACKEND_DL OFF CACHE BOOL "" FORCE)
set(GGML_BUILD_TESTS OFF CACHE BOOL "" FORCE)
set(GGML_BUILD_EXAMPLES OFF CACHE BOOL "" FORCE)
set(BUILD_SHARED_LIBS OFF CACHE BOOL "" FORCE)
add_subdirectory("${GGML_SOURCE}/ggml" ggml)
add_library(q8_control OBJECT "${GGML_SOURCE}/ggml/src/ggml-cpu/llamafile/sgemm.cpp")
add_library(q8_candidate OBJECT "${CANDIDATE_SOURCE}")
foreach(target q8_control q8_candidate)
  target_include_directories(${target} PRIVATE "${GGML_SOURCE}/ggml/include" "${GGML_SOURCE}/ggml/src"
    "${GGML_SOURCE}/ggml/src/ggml-cpu" "${GGML_SOURCE}/ggml/src/ggml-cpu/llamafile")
  target_compile_features(${target} PRIVATE cxx_std_17)
  target_compile_options(${target} PRIVATE /arch:AVX2 /utf-8 /wd4005 /wd4244 /wd4267 /wd4305 /wd4566 /wd4996 /wd4702)
  target_compile_definitions(${target} PRIVATE GGML_AVX2 GGML_BMI2 GGML_F16C GGML_FMA __BMI2__ NOMINMAX _CRT_SECURE_NO_WARNINGS)
endforeach()
target_compile_definitions(q8_control PRIVATE llamafile_sgemm=gen2_q8_tile_control_sgemm)
target_compile_definitions(q8_candidate PRIVATE llamafile_sgemm=gen2_q8_tile_candidate_sgemm GEN2_Q8_MX4_EXPECTED=1)
add_executable(q8_tile_benchmark "${BENCHMARK_SOURCE}" $<TARGET_OBJECTS:q8_control> $<TARGET_OBJECTS:q8_candidate>)
target_compile_features(q8_tile_benchmark PRIVATE cxx_std_17)
target_include_directories(q8_tile_benchmark PRIVATE "${GGML_SOURCE}/ggml/include" "${GGML_SOURCE}/ggml/src"
  "${GGML_SOURCE}/ggml/src/ggml-cpu" "${GGML_SOURCE}/ggml/src/ggml-cpu/llamafile")
target_compile_options(q8_tile_benchmark PRIVATE /arch:AVX2 /utf-8)
target_compile_definitions(q8_tile_benchmark PRIVATE NOMINMAX _CRT_SECURE_NO_WARNINGS)
target_link_libraries(q8_tile_benchmark PRIVATE ggml-base)
