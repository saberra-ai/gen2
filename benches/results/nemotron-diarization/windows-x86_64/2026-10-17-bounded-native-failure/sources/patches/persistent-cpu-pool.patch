+// Each manager serializes its Sessions through compute_mutex(). One pool can
+// therefore serve their CPU graphs without sharing workers across managers.
+struct BackendManager::CpuThreadpool {
+    using New = ggml_threadpool_t (*)(ggml_threadpool_params*);
+    using Free = void (*)(ggml_threadpool_t);
+    using Set = void (*)(ggml_backend_t, ggml_threadpool_t);
+
+    ggml_threadpool_t pool = nullptr;
+    Free free_pool = nullptr;
+    Set set_pool = nullptr;
+    ggml_backend_t backend = nullptr;  // Borrowed; BackendManager detaches first.
+
+    CpuThreadpool(ggml_backend_t cpu, int threads) : backend(cpu) {
+        if (threads < 1 || threads > GGML_MAX_N_THREADS) {
+            throw std::invalid_argument("CPU thread count is out of range");
+        }
+        auto reg = ggml_backend_dev_backend_reg(ggml_backend_get_device(cpu));
+        auto create = reinterpret_cast<New>(ggml_backend_reg_get_proc_address(reg, "ggml_threadpool_new"));
+        free_pool = reinterpret_cast<Free>(ggml_backend_reg_get_proc_address(reg, "ggml_threadpool_free"));
+        set_pool = reinterpret_cast<Set>(ggml_backend_reg_get_proc_address(reg, "ggml_backend_cpu_set_threadpool"));
+        if (!create || !free_pool || !set_pool) {
+            throw std::runtime_error("CPU thread-pool registry functions are unavailable");
+        }
+        auto settings = ggml_threadpool_params_default(threads);
+        pool = create(&settings);
+        if (!pool) {
+            throw std::runtime_error("failed to create CPU thread pool");
+        }
+        set_pool(backend, pool);
+    }
+
+    void detach() { set_pool(backend, nullptr); }
+    ~CpuThreadpool() { if (pool) free_pool(pool); }
+    CpuThreadpool(const CpuThreadpool&) = delete;
+    CpuThreadpool& operator=(const CpuThreadpool&) = delete;
+};
